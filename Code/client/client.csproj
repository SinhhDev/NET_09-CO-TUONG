		<Compile Include="..\common\Piece.cs" />
		<Compile Include="..\common\GameTimer.cs" />
		<Compile Include="..\common\MoveValidator.cs" />
		<Compile Include="..\common\ChessRules.cs" />
	</ItemGroup>
	<ItemGroup>
		<None Update="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>